static inline uint8_t io_in8(CPU* cpu, uint16_t port){ return cpu->io_in8 ? cpu->io_in8(cpu, port) : 0xFF; }
static inline void io_out8(CPU* cpu, uint16_t port, uint8_t v){ if(cpu->io_out8) cpu->io_out8(cpu, port, v); }
