#
# Automatically generated by make menuconfig: don't edit.
#


#
# Machine Identity
#

CONFIG_MACHINE_NAME="FreeRos PC1640 Compatible BIOS"
CONFIG_BIOS_BRAND="FreeRos"
CONFIG_BIOS_STYLE_NAME="PC1640-Compatible System BIOS"
CONFIG_WEBSITE="www.xt-emporium.com"
CONFIG_ROS_RELEASE=0
CONFIG_ROS_ISSUE=2

#
# Hardware
#

CONFIG_BASE_MEMORY_KB=608
CONFIG_HAS_PARADISE_PEGA1A=y
CONFIG_HAS_AMSTRAD_MOUSE=y
CONFIG_HAS_BATTERY_BACKED_RTC=y
# CONFIG_HAS_MATH_COPROCESSOR is not set

#
# Peripheral Ports
#

CONFIG_COM1_BASE=03F8
CONFIG_COM2_BASE=02F8
CONFIG_LPT1_BASE=0378
CONFIG_LPT2_BASE=03BC

#
# Video
#

# CONFIG_VIDEO_EGA_ADAPTER is not set
# CONFIG_VIDEO_40X25_COLOR is not set
CONFIG_VIDEO_80X25_COLOR=y
# CONFIG_VIDEO_MONO is not set
CONFIG_VIDEO_ATTRIBUTE=07
CONFIG_VIDEO_DIRECT_TEXT_INIT=y
CONFIG_VIDEO_USE_PC1640_SWITCH_BLOCK=y
CONFIG_VIDEO_QUERY_ROM_STATE=y
CONFIG_VIDEO_FIXUP_FROM_SWITCH_BLOCK=y

#
# Option ROMs
#

CONFIG_VIDEO_OPTION_ROM_SCAN_ENABLED=y
CONFIG_OPTION_ROM_SCAN_ENABLED=y

#
# Floppy Disk Controller
#

# CONFIG_HAS_FLOPPY_CONTROLLER is not set
CONFIG_FLOPPY_SUPPORT_35DD=y
CONFIG_FLOPPY_ENABLE_AH08_COMPAT=y

#
# IDE Hard Disk (XTIDE)
#

CONFIG_XTIDE_ENABLED=y
CONFIG_XTIDE_BASE=0300
CONFIG_XTIDE_BOOT_ENABLED=y
CONFIG_XTIDE_PROBE_MASTER=y
# CONFIG_XTIDE_PROBE_SLAVE is not set
CONFIG_XTIDE_PREFER_LBA=y
CONFIG_XTIDE_TRANSLATED_HEADS=255
CONFIG_XTIDE_TRANSLATED_SECTORS=63
CONFIG_XTIDE_POLL_LOOPS=16384
CONFIG_XTIDE_EDD_ENABLED=y
CONFIG_XTIDE_EDD_MAX_BLOCKS=127

#
# Real Time Clock Defaults
#

CONFIG_UART_INIT=E3
CONFIG_RTC_DEFAULT_SECONDS=0
CONFIG_RTC_DEFAULT_MINUTES=0
CONFIG_RTC_DEFAULT_HOURS=0
CONFIG_RTC_DEFAULT_DAY_OF_MONTH=1
CONFIG_RTC_DEFAULT_MONTH=1
CONFIG_RTC_DEFAULT_YEAR=88
CONFIG_RTC_DEFAULT_CENTURY=19

#
# POST Options
#

CONFIG_POST_PRETTY_WAIT_PANEL=y
# CONFIG_POST_SPACE_INVADERS_SOUND is not set

#
# Debug
#

# CONFIG_DEBUG_PORT_E9 is not set
# CONFIG_DEBUG_COM1 is not set
# CONFIG_DEBUG_VIDEO_STATE is not set
# CONFIG_DEBUG_VIDEO_OVERLAY is not set
# CONFIG_TRACE_VIDEO_COM1 is not set
